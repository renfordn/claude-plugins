{
  "name": "plugin-harness",
  "version": "2.1.2",
  "displayName": "Plugin Harness",
  "description": "Caching-first multi-plugin workflow router that coordinates plugin capabilities via INTEROP.md contracts, distributes nelly brief once, and maximizes prompt cache efficiency via three-tier context layout.",
  "homepage": "https://github.com/renfordn/claude-plugins/tree/main/plugin-harness",
  "author": {
    "name": "Renford Nelson"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "orchestration",
    "workflow",
    "plugin-coordination",
    "caching",
    "context-optimization"
  ],
  "mcpServers": {
    "spawn-context": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp_server/server.py"
      ]
    }
  },
  "first_class": {
    "declared_absent": [
      "commands",
      "skills",
      "agents"
    ]
  }
}
