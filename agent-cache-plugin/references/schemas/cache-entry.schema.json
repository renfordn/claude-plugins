{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cache Entry Schema",
  "description": "Schema for cache entries stored in Agent-Cache",
  "type": "object",
  "required": ["id", "prompt", "output", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the cache entry",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "prompt": {
      "type": "string",
      "description": "The original prompt/task that generated this cached output",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "description": "The agent output or reasoning result (serialized if not string)",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": ["agentType", "timestamp", "ttl"],
      "properties": {
        "agentType": {
          "type": "string",
          "description": "Type of agent that generated this entry",
          "examples": ["agent-tdd:agent-TDD", "agent-cache-orchestrator", "general-purpose"]
        },
        "agentId": {
          "type": "string",
          "description": "ID of the specific agent instance"
        },
        "taskType": {
          "type": "string",
          "description": "Type of task (e.g., 'research', 'implementation', 'review')",
          "examples": ["research", "implementation", "review", "general"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Search tags for categorization and retrieval"
        },
        "tokenCount": {
          "type": "number",
          "description": "Total tokens in input + output",
          "minimum": 0
        },
        "inputTokens": {
          "type": "number",
          "description": "Input tokens used",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "description": "Output tokens generated",
          "minimum": 0
        },
        "executionTime": {
          "type": "number",
          "description": "Time taken to generate output in milliseconds",
          "minimum": 0
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp when entry was created",
          "minimum": 0
        },
        "ttl": {
          "type": "number",
          "description": "Time-to-live in milliseconds",
          "minimum": 60000,
          "examples": [3600000, 86400000, 604800000]
        },
        "parameters": {
          "type": "object",
          "description": "Sanitized execution parameters (secrets removed)"
        }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "description": "Usage statistics for this cache entry",
      "properties": {
        "hits": {
          "type": "number",
          "description": "Number of times this entry was reused",
          "minimum": 0
        },
        "lastAccessed": {
          "type": "number",
          "description": "Unix timestamp of last access",
          "minimum": 0
        },
        "createdAt": {
          "type": "number",
          "description": "Unix timestamp when created",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
